# .gitignore for WordPress Plugin Development

# Ignore node_modules and vendor (except for autoload.php)
node_modules/
vendor/
!vendor/autoload.php

# Ignore Composer files except composer.json
composer.lock

# Ignore build and log files
*.log
dist/
build/

# Ignore OS generated files
.DS_Store
Thumbs.db

# Ignore IDE/project files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Ignore environment files
.env
.env.*

# Ignore backup and temp files
*~
*.swp
*.bak
*.tmp

# Ignore uploads and cache
uploads/
.cache/

# Ignore WordPress core files (if present)
wp-admin/
wp-includes/
wp-content/
!wp-content/plugins/
!wp-content/themes/

# Ignore SQL dumps
*.sql
*.sql.gz
