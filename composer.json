{
    "name": "arifrahman/genform",
    "description": "GenForm - Drag & Drop Form Builder",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Arif Rahman",
            "email": "arifrahman1@example.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "freemius/wordpress-sdk": "^2.13"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}